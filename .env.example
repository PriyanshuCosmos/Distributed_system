# ==============================================================================
# TaskFlow Configuration Example
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your environment.
#
# Docker Compose uses PostgreSQL and Redis automatically:
#   DATABASE_URL=postgresql+psycopg://taskflow:taskflow@localhost:5432/taskflow
#   REDIS_URL=redis://localhost:6379/0
#
# For local development without Docker, TaskFlow can run with SQLite and
# an embedded in-memory Redis simulator (fakeredis):
#   DATABASE_URL=sqlite+aiosqlite:///./taskflow.db
#   USE_FAKEREDIS=true
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=TaskFlow

# Server Binding
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration (PostgreSQL in production/Docker, SQLite option for local standalone)
DATABASE_URL=postgresql+psycopg://taskflow:taskflow@localhost:5432/taskflow
# Synchronous URL for Alembic migrations and sync scripts:
SYNC_DATABASE_URL=postgresql+psycopg://taskflow:taskflow@localhost:5432/taskflow

# Redis Broker Configuration
REDIS_URL=redis://localhost:6379/0
USE_FAKEREDIS=false

# Worker Configuration
WORKER_CONCURRENCY=4
WORKER_POLL_TIMEOUT=2.0
WORKER_HEARTBEAT_INTERVAL=5.0
WORKER_LEASE_DURATION=15.0

# Task Execution & Reliability Defaults
DEFAULT_MAX_RETRIES=3
DEFAULT_TASK_TIMEOUT_SECONDS=60.0
BACKOFF_BASE_SECONDS=2.0
BACKOFF_MAX_SECONDS=300.0
BACKOFF_JITTER=true

# Scheduler & Dispatcher Intervals
SCHEDULER_POLL_INTERVAL=1.0
STALE_JOB_CHECK_INTERVAL=5.0
OUTBOX_POLL_INTERVAL=1.0

# Security & Constraints
MAX_PAYLOAD_BYTES=65536
CORS_ORIGINS=["*"]
